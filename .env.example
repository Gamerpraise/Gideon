# Set these on Render → Environment (or copy to ".env" for local use). ALL optional.

PORT=8000

# ═══ BOT HOSTING ═══════════════════════════════════════════════════════════
BOT_HOSTING=on
# How many people's bots this server runs at once. Free Render (512 MB RAM): keep it at 6–10.
MAX_BOTS=8
# Add more trusted owner numbers besides 2348057940822 (digits only, comma separated). Optional.
OWNER_EXTRA=
# Try to auto-follow CHANNEL_URL on every hosted bot. Set to "false" to disable.
AUTO_FOLLOW_CHANNEL=true

# ═══ KEEP BOTS AFTER RESTARTS (strongly recommended on free Render) ═══════
# Free Render wipes its disk on every restart/deploy. Add a free MongoDB Atlas database and
# every login is saved ENCRYPTED, so all bots come back by themselves after a restart.
MONGODB_URI=
# Secret used to encrypt the saved logins (min 12 characters). Keep it safe — losing it makes backups unreadable.
DATA_KEY=
BACKUP_EVERY_MIN=3
DATA_DIR=./data

# ═══ WEBSITE / BRANDING ═════════════════════════════════════════════════════
SITE_NAME=Gideon
YOUTUBE_URL=https://youtube.com/@gamerpraise-mods
GITHUB_URL=https://github.com/Gamerpraise/
CHANNEL_URL=https://whatsapp.com/channel/0029VbBRPc3CMY0IePiiU808
MAX_ACTIVE_SESSIONS=40
COUNTER_FILE=./counter.json
WA_VERSION=

# ═══ BOT SETTINGS (shared by every hosted bot) ════════════════════════════
BOT_NAME=Gideon
OWNER_NAME=Gpraise
PREFIX=.
TZ=Africa/Lagos
MENU_IMAGE=
MAX_WARNS=3
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
